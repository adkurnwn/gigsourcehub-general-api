PORT=5050
HOST=localhost # localhost / google.com
TIMEOUT=5
AI_SEARCH_TIMEOUT=120
GO_ENV=development

APP_URL=

# logger
LOG_TO_STDOUT=true
LOG_TO_FILE=false
LOG_FILENAME=server.log
LOG_MAX_SIZE=50

# db connection
POSTGRES_URL=postgres://user:password@127.0.0.1:5432/nexus?sslmode=disable

# redis cache
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=60s
REDIS_KEY_PREFIX="app:"

# jwt
JWT_MEMBER_SECRET_KEY=
JWT_MEMBER_TTL=60 # in minutes

# S3
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=bucket-name
S3_PUBLIC_URL=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE_CV_UPLOAD=cv_upload_queue

# AI Service
AI_API_URL=localhost:50051
INTERNAL_API_TOKEN=
