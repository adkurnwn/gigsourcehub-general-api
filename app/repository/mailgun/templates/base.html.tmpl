{{ define "email_styles" }}
  body {
    margin: 0;
    padding: 0;
    min-width: 100%;
    background-color: #f4f7f9;
    font-family: 'Inter', Arial, sans-serif;
    color: #505050;
  }

  table {
    border-collapse: collapse;
    mso-table-lspace: 0pt;
    mso-table-rspace: 0pt;
  }

  .outer {
    width: 100%;
    background-color: #f4f7f9;
    padding: 32px 0 40px;
  }

  .card {
    width: 100%;
    max-width: 680px;
    background-color: #ffffff;
    border-radius: 24px;
    box-shadow: 0 24px 60px rgba(15, 23, 42, 0.08);
  }

  .content-cell {
    padding: 40px 40px 32px;
    text-align: center;
  }

  .logo-title {
    margin: 0;
    font-size: 30px;
    font-weight: 800;
    color: #07229e;
    letter-spacing: -0.03em;
  }

  .logo-subtitle {
    margin: 6px 0 0;
    font-size: 18px;
    font-weight: 500;
    color: #0f172a;
  }

  .hero-heading {
    margin: 32px 0 0;
    font-size: 24px;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.2;
  }

  .body-copy {
    margin: 18px auto 0;
    max-width: 520px;
    font-size: 16px;
    line-height: 1.8;
    color: #505050;
  }

  .button {
    display: inline-block;
    background-color: #07229e;
    color: #ffffff !important;
    text-decoration: none !important;
    padding: 14px 24px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 700;
    margin: 28px 0 0;
  }

  .link-text {
    color: #1d4ed8;
    text-decoration: underline;
    word-break: break-word;
  }

  .support-note {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: #505050;
  }

  .copy-note {
    margin: 8px 0 0;
    font-size: 12px;
    line-height: 1.7;
    color: #9e9e9e;
  }
{{ end }}

{{ define "email_header" }}
  <tr>
    <td class="content-cell" style="padding: 40px 40px 0; text-align: center;">
      <table role="presentation" align="center" style="margin:0 auto;">
        <tr>
          <td style="padding:0; vertical-align:middle;">
            <img src="{{ .LogoURL }}" width="179" height="95" alt="Gigsourcehub logo" style="display:block; border:0; outline:none; text-decoration:none; width:179px; height:95px;" />
          </td>
        </tr>
      </table>
    </td>
  </tr>
{{ end }}

{{ define "email_footer" }}
  <tr>
    <td class="content-cell" style="padding: 0 40px 32px; text-align: center;">
      <p class="support-note" style="margin:0;">If you have any questions, please check the <a href="{{ .AppURL }}/faq" class="link-text" style="color:#1d4ed8; text-decoration:underline;">FAQ section</a> on our website or contact us at <a href="mailto:admin@gigsourcehub.app" class="link-text" style="color:#1d4ed8; text-decoration:underline;">admin@gigsourcehub.app</a>.</p>
      <p class="copy-note" style="margin:16px 0 0;">Copyright © 2026 GigSource Hub. All rights reserved.</p>
    </td>
  </tr>
{{ end }}
