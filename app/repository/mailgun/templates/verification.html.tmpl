{{ define "verification" }}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ .Subject }}</title>
  <style>{{ template "email_styles" . }}</style>
</head>
<body>
  <table role="presentation" width="100%" class="outer" style="background-color:#f4f7f9; width:100%;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" class="card" style="max-width:680px; width:100%; background-color:#ffffff; border-radius:24px; box-shadow:0 24px 60px rgba(15,23,42,0.08);">
          {{ template "email_header" . }}
          <tr>
            <td class="content-cell" style="padding: 24px 40px 0; text-align:center;">
              <p class="hero-heading" style="margin:0;">Hi {{ .Name }}!</p>
              <p class="body-copy" style="margin:24px auto 0; max-width:520px; font-size:16px; line-height:1.8; color:#505050;">Welcome to GigSourceHub! Please verify your account by clicking the button below.</p>
              <p style="margin:28px 0 0;"><a href="{{ .ActionURL }}" class="button" style="background-color:#07229e; color:#ffffff; text-decoration:none; padding:14px 24px; border-radius:8px; display:inline-block; font-size:16px; font-weight:700;">{{ .ButtonText }}</a></p>
              <p class="body-copy" style="margin:28px auto 0; max-width:520px; font-size:16px; line-height:1.8; color:#505050;">If you're having trouble clicking the button, copy and paste the URL below into your web browser:</p>
              <p class="body-copy" style="margin:12px auto 0; max-width:520px;"><a href="{{ .ActionURL }}" class="link-text" style="color:#1d4ed8; text-decoration:underline; word-break:break-all;">{{ .ActionURL }}</a></p>
              <p class="body-copy" style="margin:20px auto 0; max-width:520px;">This link will expire in 24 hours.</p>
            </td>
          </tr>
          <tr>
            <td class="content-cell" style="padding: 0 40px 32px; text-align:center;">
              <p class="body-copy" style="margin:0 auto; max-width:520px;">If you did not request this verification email, please ignore it.</p>
              <p class="body-copy" style="margin:20px auto 0; max-width:520px;">Best regards,<br>GigSourceHub Team</p>
            </td>
          </tr>
          {{ template "email_footer" . }}
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
{{ end }}
